<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FedoraLink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
    </style>

    <!-- ClipboardSendActivity must be on screen to read the clipboard, but
         should never actually be seen. -->
    <style name="Theme.FedoraLink.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
